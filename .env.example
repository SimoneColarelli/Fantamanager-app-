# Copy this file to .env and fill in local values.

# Sync mode: off | manual | auto
FANTAMANAGER_SYNC_MODE=off

# Direct Postgres connection string from Supabase.
# Find it in Supabase Dashboard > Project Settings > Database > Connection string.
FANTAMANAGER_SUPABASE_DB_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres?sslmode=require

# Supabase API values kept for future API/RLS based sync work.
# They are not used by the current SQLAlchemy snapshot sync yet.
FANTAMANAGER_SUPABASE_URL=https://PROJECT_REF.supabase.co
FANTAMANAGER_SUPABASE_ANON_KEY=YOUR_ANON_KEY
FANTAMANAGER_SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional. Use true only if Supabase should replace the local SQLite data at startup.
FANTAMANAGER_SYNC_PULL_ON_START=false
